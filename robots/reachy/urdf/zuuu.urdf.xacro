<?xml version="1.0"?>
<!-- PATCH (isaac-social-nav): stripped Zuuu mobile base for Isaac URDF import.
     Kinematics from pollen reachy_2023/mobile_base_controller/zuuu_description
     (lidar at 0.184,0,0.25; mesh mobile_base_visual.dae). No Gazebo / ros2_control.
     Wheels are fixed (kinematic chassis, not PhysX omni drive). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zuuu">
  <xacro:macro name="zuuu">
    <xacro:property name="base_radius" value="0.16"/>
    <xacro:property name="wheel_radius" value="0.105"/>
    <xacro:property name="wheel_width" value="0.035"/>
    <xacro:property name="wheel_radial_dist" value="0.1805"/>
    <xacro:property name="mesh_dir" value="../meshes"/>

    <xacro:macro name="cylinder_inertia" params="m r h">
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${m}"/>
        <inertia
          ixx="${(m/12) * (3*r*r + h*h)}" ixy="0" ixz="0"
          iyy="${(m/12) * (3*r*r + h*h)}" iyz="0"
          izz="${(m/2) * (r*r)}"/>
      </inertial>
    </xacro:macro>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="base_footprint"/>
      <child link="base_link"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/mobile_base_visual.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 0 0.145" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.245" length="0.19"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.008 -0.00048 0.112" rpy="0 0 0"/>
        <mass value="24.0"/>
        <inertia
          ixx="0.40791094" ixy="-0.00167148" ixz="-0.00178789"
          iyy="0.4236827" iyz="0.00026596" izz="0.70990763"/>
      </inertial>
    </link>

    <xacro:macro name="wheel" params="prefix yaw_angle">
      <link name="${prefix}_link">
        <visual>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </visual>
        <collision>
          <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </collision>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
      </link>
      <joint name="${prefix}_joint" type="fixed">
        <parent link="base_link"/>
        <child link="${prefix}_link"/>
        <origin
          xyz="${(wheel_radial_dist+wheel_width/2)*cos(yaw_angle)} ${-(wheel_radial_dist+wheel_width/2)*sin(yaw_angle)} ${wheel_radius}"
          rpy="0 0 ${pi/2-yaw_angle}"/>
        <axis xyz="0 1 0"/>
      </joint>
    </xacro:macro>

    <xacro:wheel prefix="drivewhl1" yaw_angle="${pi/3}"/>
    <xacro:wheel prefix="drivewhl2" yaw_angle="${5*pi/3}"/>
    <xacro:wheel prefix="drivewhl3" yaw_angle="${pi}"/>

    <link name="imu_link"/>
    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0.01"/>
    </joint>

    <link name="lidar_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.125"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.035" length="0.035"/>
        </geometry>
      </collision>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_link"/>
      <origin xyz="0.184 0 0.25" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
